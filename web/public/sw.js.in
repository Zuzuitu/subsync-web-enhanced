const BUILD_HASH = '__BUILD_HASH__';
const CACHE_NAME = 'subsync2-shell-' + BUILD_HASH;
const versioned = path => path + '?' + BUILD_HASH;
const OFFLINE_INDEX = versioned('./index.html');
const APP_SHELL = [
  OFFLINE_INDEX,
  versioned('./app.css'),
  versioned('./manifest.webmanifest'),
  versioned('./icon.svg'),
  versioned('./scripts/subsync.js'),
  versioned('./scripts/extractor.wasm'),
  versioned('./scripts/correlator.wasm')
];

self.addEventListener('install', event => {
  event.waitUntil(
    caches.open(CACHE_NAME)
      .then(cache => cache.addAll(APP_SHELL))
      .then(() => self.skipWaiting())
  );
});

self.addEventListener('activate', event => {
  event.waitUntil(
    caches.keys()
      .then(keys => Promise.all(
        keys
          .filter(key => key.startsWith('subsync2-shell-') && key !== CACHE_NAME)
          .map(key => caches.delete(key))
      ))
      .then(() => self.clients.claim())
  );
});

function cacheSuccessful(request, response) {
  if (response && response.ok) {
    const copy = response.clone();
    caches.open(CACHE_NAME).then(cache => cache.put(request, copy));
  }
  return response;
}

self.addEventListener('fetch', event => {
  if (event.request.method !== 'GET') return;

  const url = new URL(event.request.url);
  if (url.origin !== self.location.origin) return;

  // Speech/dictionary packages are already persisted by the application in IDBFS.
  // Avoid keeping a second ~40 MB copy in Cache Storage.
  if (url.pathname.includes('/assets/data/')) return;

  // Always ask the server which build is current. This request is tiny and is
  // the recovery signal for an installed PWA after a new GitHub Pages deploy.
  if (url.pathname.endsWith('/build-manifest.json')) {
    event.respondWith(fetch(event.request, { cache: 'no-store' }));
    return;
  }

  // Never pin navigations to an old cached index. Fetch the current shell first
  // and fall back to the versioned offline index only when the network is down.
  if (event.request.mode === 'navigate') {
    event.respondWith(
      fetch(event.request, { cache: 'no-store' })
        .then(response => cacheSuccessful(OFFLINE_INDEX, response))
        .catch(() => caches.match(OFFLINE_INDEX))
    );
    return;
  }

  // Versioned shell resources are immutable for one build, so cache-first is
  // safe. A new build gets a different URL and cannot collide with this cache.
  event.respondWith(
    caches.match(event.request).then(cached => {
      if (cached) return cached;
      return fetch(event.request).then(response => cacheSuccessful(event.request, response));
    })
  );
});
