    "bootstrapExceptionCommit": "96371770728e930fb1e5709cb4036f394b81e294",
    "neverWeakenInvariantsToPassCI": true
  },
  "product": {
    "browserFirst": true,
    "pwaTarget": true,
    "primaryBugTarget": "direct MKV + SRT reliability",
    "multiUploadNearTermPriority": false,
    "preserveSynchronizationSemanticsDuringExtractorFixes": true,
    "primaryLanguagePriority": "Romanian subtitles",
    "romanian": {
      "subtitleSupportRequired": true,
      "audioSpeechRecognitionRequired": true,
      "acceptedLanguageCodes": [
        "ro",
        "rum",
        "ron"
      ],
      "preserveDiacritics": true,
      "audioSpeechRecognitionNearTermPriority": false,
      "audioSpeechRecognitionDeferredUntilNearCompletion": true
    },
    "primaryWorkflow": {
      "referenceAudioLanguage": "English",
      "referenceAudioCode": "eng",
      "subtitleLanguage": "Romanian",
      "subtitleLanguageCodes": [
        "ro",
        "rum",
        "ron"
      ],
      "endToEndRequiredBeforeRelease": true
    },
    "originalLanguageCompatibility": {
      "preservePinnedSc0tyCatalog": true,
      "speechCatalogCodes": [
        "chi",
        "dut",
        "eng",
        "fre",
        "ger",
        "gre",
        "ita",
        "rus",
        "spa"
      ],
      "dictionaryPackageCount": 217,
      "noSilentRegression": true,
      "fullPerLanguageE2EStillRequiredBeforeClaimingUniversalBehavioralParity": true
    }
  },
  "evidence": {
    "noInventedResults": true,
    "noRootCauseClaimWithoutReproduction": true,
    "distinguishObservationHypothesisAndConfirmedResult": true
  },
  "privacy": {
    "preferLocalBrowserProcessing": true,
    "serverMediaUploadRequiresExplicitArchitectureDecision": true
  },
  "testing": {
    "regressionTestRequiredForConfirmedBugFix": true,
    "legalRedistributableFixturesOnly": true,
    "initialMkvMatrix": [
      "AAC",
      "AC3",
      "E-AC3",
      "multiple-audio-tracks",
      "embedded-subtitles"
    ],
    "romanianUtf8SubtitleRegressionRequired": true,
    "englishAudioRomanianSubtitleEndToEndRequired": true,
    "mkvReliabilityCoverage": [
      "H.264 + stereo AAC",
      "HEVC/H.265 + E-AC3 5.1",
      "reversed multiple-audio-track selection",
      "long-duration split-window seek"
    ],
    "timeWindowSeek": {
      "mustNotSkipForwardPastRequestedStart": true,
      "regressionRequired": true
    },
    "stageSpecificDiagnostics": {
      "required": true,
      "preserveNativeModuleEvidence": true,
      "noRootCauseClaimFromFallbackOnly": true
    },
    "largeFileBrowserStress": {
      "required": true,
      "minimumFixtureMiB": 128,
      "browsers": [
        "Chromium",
        "iPhone-like WebKit"
      ],
      "physicalIPhoneClaimRequiresPhysicalDeviceEvidence": true,
      "rssMetricIsProcessTreeBaselineNotTabMemory": true
    }
  },
  "deployment": {
    "productionConfigured": false,
    "productionMode": "manual",
    "autoDeployProduction": false
  },
  "cost": {
    "paidServicesRequireExplicitApproval": true,
    "preferFreeOrLowCostCloudCI": true
  }
