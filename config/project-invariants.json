    "originalAuthor": "Michał Szymaniak (sc0ty)",
    "requireSc0tyAttribution": true,
    "attributionSurfaces": [
      "README.md",
      "credits/about surface when introduced"
    ]
  },
  "workflow": {
    "materialChanges": [
      "branch",
      "pull_request",
      "ci_green",
      "merge"
