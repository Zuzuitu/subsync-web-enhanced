{
  "schemaVersion": 1,
  "project": "SubSync2",
  "repository": "Zuzuitu/subsync-web-enhanced",
  "sourceOfTruth": {
    "rule": "repository_over_chat_memory",
    "readOrder": [
      "docs/PROJECT_STATE.md",
      "config/project-invariants.json",
      "AGENTS.md",
      "relevant current implementation"
    ]
  },
  "upstream": {
    "repository": "sc0ty/subsync",
    "pinnedBaseline": "c888da7257d57bf039523c9f7015feacb4b95dc3",
    "baselineFile": "UPSTREAM_COMMIT",
    "requireExplicitPinnedCommitForRefresh": true,
    "requirePRForRefresh": true
  },
  "licensing": {
    "license": "GPL-3.0",
